# Copy to .env.local and fill in (never commit .env.local).
# Supabase → Project Settings → API. Both values are public (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public site URL (used for canonical URLs, sitemap and OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed for a *local* Supabase stack (`supabase start`) with Google sign-in.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
