{
  "name": "assay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "seed:build": "node scripts/register-tasks.mjs && tsx scripts/build-seed.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "db:push": "supabase db push --remote --include-seed",
    "db:seed": "npm run seed:build && node scripts/seed-remote.mjs",
    "db:types": "supabase gen types --lang=typescript --remote --schema public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@electric-sql/pglite": "^0.5.17",
    "@lezer/highlight": "^1.2.5",
    "@mlc-ai/web-llm": "^0.2.89",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "fuse.js": "^7.5.0",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "gray-matter": "^4.0.3",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
